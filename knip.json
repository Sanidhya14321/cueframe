{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "playwright": false,
  "entry": [
    "scripts/*.ts",
    "src/{schemas,project,core,compositions,design}/index.ts",
    "src/compositions/entry.ts",
    "playwright.config.ts",
    "e2e/**/*.spec.ts",
    "src/render/posters/preview-entry.tsx",
    "src/posters/{kit/index,pack}.ts",
    "src/render/render-local.ts",
    "src/render/render-layer.ts",
    "src/render/render-opencut.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}", "e2e/**/*.ts", "scripts/**/*.ts"],
  "ignore": ["src/components/ui/**"],
  "ignoreBinaries": ["ffmpeg"],
  "ignoreDependencies": ["tw-animate-css", "tailwindcss"]
}
